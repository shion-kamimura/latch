      "category": "abnormal",
      "coveredBy": "none",
      "body": {
        "lines": [
          {
            "sku": "SKU-001",
            "quantity": 1,
            "unitPriceCents": -1
          }
        ]
      },
      "expected": {
        "status": 400,
