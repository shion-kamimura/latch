{
  "$comment": "Latch評価用の正解データ。候補へコピーせず、LLM入力にも含めない。利用方法は fixtures/order-api/README.md を参照。",
  "request": {
    "method": "POST",
    "path": "/orders/total"
  },
  "cases": [
    {
      "id": "normal.single-line",
      "category": "normal",
      "coveredBy": "existing",
      "body": {
        "lines": [
          {
            "sku": "SKU-001",
            "quantity": 2,
            "unitPriceCents": 500
          }
        ]
      },
      "expected": {
        "status": 200,
        "body": {
          "subtotalCents": 1000,
          "totalCents": 1000,
          "appliedCoupon": null
        }
      }
    },
    {
      "id": "normal.coupon-save10",
      "category": "normal",
      "coveredBy": "existing",
      "body": {
        "lines": [
          {
            "sku": "SKU-001",
            "quantity": 2,
            "unitPriceCents": 500
          }
        ],
        "couponCode": "SAVE10"
      },
      "expected": {
        "status": 200,
        "body": {
          "subtotalCents": 1000,
          "totalCents": 900,
          "appliedCoupon": "SAVE10"
        }
      }
    },
    {
      "id": "normal.coupon-save20",
      "category": "normal",
      "coveredBy": "none",
      "body": {
        "lines": [
          {
            "sku": "SKU-001",
            "quantity": 2,
            "unitPriceCents": 500
          }
        ],
        "couponCode": "SAVE20"
      },
      "expected": {
        "status": 200,
        "body": {
          "subtotalCents": 1000,
          "totalCents": 800,
          "appliedCoupon": "SAVE20"
        }
      }
    },
    {
      "id": "normal.multiple-lines",
      "category": "normal",
      "coveredBy": "existing",
      "body": {
        "lines": [
          {
            "sku": "SKU-001",
            "quantity": 2,
            "unitPriceCents": 500
          },
          {
            "sku": "SKU-002",
            "quantity": 1,
            "unitPriceCents": 250
          }
        ]
      },
      "expected": {
        "status": 200,
        "body": {
          "subtotalCents": 1250,
          "totalCents": 1250,
          "appliedCoupon": null
        }
      }
    },
    {
      "id": "abnormal.empty-lines",
      "category": "abnormal",
      "coveredBy": "existing",
      "body": {
        "lines": []
      },
      "expected": {
        "status": 400,
        "body": {
          "error": "lines must be a non-empty array"
        }
      }
    },
    {
      "id": "abnormal.lines-not-array",
      "category": "abnormal",
      "coveredBy": "none",
      "body": {
        "lines": {}
      },
      "expected": {
        "status": 400,
        "body": {
          "error": "lines must be a non-empty array"
        }
      }
    },
    {
      "id": "abnormal.unknown-coupon",
      "category": "abnormal",
      "coveredBy": "none",
      "body": {
        "lines": [
          {
            "sku": "SKU-001",
            "quantity": 1,
            "unitPriceCents": 100
          }
        ],
        "couponCode": "FREEFALL"
      },
      "expected": {
        "status": 400,
        "body": {
          "error": "unknown coupon"
        }
      }
    },
    {
      "id": "abnormal.quantity-above-line-max",
      "category": "abnormal",
